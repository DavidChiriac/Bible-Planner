{
  "name": "bible-planner",
  "version": "2.2.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:mobile": "ng build --configuration production --base-href ./",
    "build": "npm run build:mobile && npm run postbuild:pages",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "build:pages": "ng build --configuration production --base-href \"/Bible-Planner/\"",
    "postbuild:pages": "node -e \"require('fs').copyFileSync('dist/bible-planner/browser/index.csr.html','dist/bible-planner/browser/index.html')\"",
    "deploy": "npm run build:pages && npm run postbuild:pages && gh-pages -d dist/bible-planner/browser",
    "serve:ssr:bible-planner": "node dist/bible-planner/server/server.mjs",
    "capacitor:sync": "npx cap sync android",
    "capacitor": "npm run build && npm run capacitor:sync && npx cap run android",
    "commit": "git cz",
    "release": "standard-version --commit-all",
    "release:minor": "standard-version --commit-all --release-as minor",
    "release:major": "standard-version --commit-all --release-as major",
    "ship": "npm run commit && npm run release && node scripts/create-release-branch.js && git push --follow-tags origin HEAD",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.1.4",
    "@angular/cdk": "^21.1.4",
    "@angular/common": "21.1.4",
    "@angular/compiler": "21.1.4",
    "@angular/core": "21.1.4",
    "@angular/fire": "^21.0.0-rc.0-canary.ac3dd7c",
    "@angular/forms": "21.1.4",
    "@angular/platform-browser": "21.1.4",
    "@angular/platform-browser-dynamic": "21.1.4",
    "@angular/platform-server": "21.1.4",
    "@angular/router": "21.1.4",
    "@angular/ssr": "^21.1.4",
    "@capacitor-firebase/authentication": "^8.0.1",
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.5",
    "@primeuix/themes": "^2.0.3",
    "docx": "^9.6.1",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.9.0",
    "ngx-quill": "^30.0.1",
    "ngx-webstorage": "^21.0.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.1",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^21.0.3",
    "@angular/build": "21.1.4",
    "@angular/cli": "21.1.4",
    "@angular/compiler-cli": "^21.1.3",
    "@capacitor/assets": "^3.0.5",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.19",
    "angular-cli-ghpages": "^3.0.2",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^16.1.1",
    "standard-version": "^9.5.0",
    "typescript": "~5.9.3"
  }
}
