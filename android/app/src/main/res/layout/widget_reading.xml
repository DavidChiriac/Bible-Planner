<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bible Agenda"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#4C362D"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#A46447"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Progres citire"
        android:textSize="15sp"
        android:textColor="#6B5A45"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/widget_step"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#88937B"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/widget_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deschide aplicația"
        android:textSize="14sp"
        android:textColor="#6B5A45"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
